# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# OpenAI API key powering the AI interviewer.
# If left empty, the app falls back to a small set of mock questions.
OPENAI_API_KEY=""

# Optional: override the OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"
