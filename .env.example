# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# ----- AI provider for the interviewer -----
# Pick ONE provider by setting its API key. If none is set, the app falls back
# to a small set of mock questions. AI_PROVIDER is optional; if omitted the app
# auto-detects based on which key is present (groq > gemini > openai).
#
# AI_PROVIDER="groq" | "gemini" | "openai"

# Groq (free tier, fast Llama models) — https://console.groq.com/keys
GROQ_API_KEY=""

# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# OpenAI (paid) — https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Optional: override the default model for the chosen provider.
# groq default: llama-3.3-70b-versatile
# gemini default: gemini-2.0-flash
# openai default: gpt-4o-mini
# AI_MODEL=""
